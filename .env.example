DATABASE_URL=postgresql+psycopg://devflow:devflow@postgres:5432/devflow
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# Place the PEM in the ignored root .secrets directory.
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
MAX_FILES=20
MAX_PATCH_CHARS_PER_FILE=20000
MAX_TOTAL_PATCH_CHARS=100000
ANALYZER_TIMEOUT_SECONDS=30
MAX_SOURCE_BYTES_PER_FILE=1000000

# Gemini review (enable after configuring your local key)
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_MAX_FILES=20
AI_MAX_DIFF_CHARS=20000
AI_MAX_TOTAL_INPUT_CHARS=100000
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
GEMINI_API_KEY=

# Requires accepted Checks write permission on the GitHub App installation
GITHUB_CHECKS_ENABLED=true
